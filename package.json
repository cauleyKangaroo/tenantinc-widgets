{
  "name": "tenantinc-widgets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "smoke": "npm run build && node dev/smoke-test.js",
    "test:phone": "tsc src/shared/ui/phone.ts --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tmp-test && node dev/phone-test.js",
    "deploy": "gulp upload:dry && npm run build && gulp upload",
    "deploy:dev": "cross-env DEPLOY_TARGET=dev npm run deploy",
    "deploy:demo": "cross-env DEPLOY_TARGET=demo npm run deploy",
    "upload": "gulp upload",
    "upload:dry": "gulp upload:dry"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrent-transform": "^1.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.4",
    "docx": "^9.7.1",
    "dotenv": "^8.1.0",
    "dotenv-webpack": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gulp": "^4.0.2",
    "gulp-awspublish": "^4.0.1",
    "gulp-rename": "^1.4.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
